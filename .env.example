# CONFIG DATABASE
DB_URL='postgresql+psycopg2://CHANGE-ME:YOURPASSWORD@CHANGE-ME:CHANGE-ME/YOUR-DATABASE-NAME'
DB_USER='CHANGE-ME'
DB_PASSWORD='YOURPASSWORD'
DB_HOST='CHANGE-ME'
DB_PORT='CHANGE-ME'
DB_NAME='YOUR-DATABASE-NAME'

# CONFIG DATABASE TO ALEMBIC
ALEMBIC_DATABASE_URL=postgresql+psycopg2://CHANGE-ME:YOURPASSWORD@CHANGE-ME:CHANGE-ME/YOUR-DATABASE-NAME


# SYSTEM OWNER (created automatically on first startup)
OWNER_EMAIL=owner@orderflow.com
OWNER_USERNAME=owner
OWNER_PASSWORD=ChangeMe@2026
OWNER_FIRST_NAME=System
OWNER_LAST_NAME=Owner



# ENVIRONMENT
ENV=development


# CONFIG JWT
SECRET_KEY='your_secret_key'
ALGORITHM='HS256'
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


# NAME API AND VERSION
API_TITLE='Your API Title'
API_VERSION='1.0.0'
API_V1_PREFIX='/api/v1'



# CONFIG LOGGING

# Can be DEBUG, INFO, WARNING, ERROR, CRITICAL
# to production, use INFO or WARNING to reduce log verbosity
LOG_LEVEL=DEBUG  

# to production, use JSON for better log parsing and analysis
LOG_FORMAT=text