# CONFIG DATABASE
DB_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/orderflow_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orderflow_db

# CONFIG DATABASE TO ALEMBIC
ALEMBIC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/orderflow_db


# SYSTEM OWNER (created automatically on first startup)
OWNER_USERNAME=owner
OWNER_PASSWORD=ChangeMe@2026
OWNER_EMAIL=owner@orderflow.com
OWNER_FIRST_NAME=System
OWNER_LAST_NAME=Owner



# ENVIRONMENT
# Options: development, production
# In development: Swagger UI (/docs), ReDoc (/redoc) and OpenAPI (/openapi.json) are enabled
# In production: all API documentation endpoints are disabled automatically
ENV=development


# CONFIG JWT
# Generate a strong secret key: openssl rand -hex 32
SECRET_KEY=your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


# NAME API AND VERSION
API_TITLE=Your API Title
API_VERSION=1.0.0
API_V1_PREFIX=/api/v1



# CONFIG LOGGING
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# In production, use INFO or WARNING to reduce log verbosity
LOG_LEVEL=DEBUG

# Options: text, json
# In production, use JSON for better log parsing and analysis
LOG_FORMAT=text